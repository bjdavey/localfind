<?xml version="1.0" encoding="utf-8"?>
<!-- Magnifier with sparkle (master: docs/art/app-icon.svg). The group scales the 108 canvas glyph
     to ~60% and centers it so it stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="22.4"
        android:translateY="22.4">
        <!-- Ring -->
        <path
            android:fillColor="#00000000"
            android:pathData="M14,44a30,30 0 1,0 60,0a30,30 0 1,0 -60,0"
            android:strokeColor="#1A73E8"
            android:strokeWidth="7" />
        <!-- Handle -->
        <path
            android:fillColor="#00000000"
            android:pathData="M67,67L90,90"
            android:strokeColor="#1A73E8"
            android:strokeLineCap="round"
            android:strokeWidth="10" />
        <!-- Lens -->
        <path
            android:fillColor="#1A73E8"
            android:pathData="M23,44a21,21 0 1,0 42,0a21,21 0 1,0 -42,0z" />
        <!-- Sparkle -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44,29Q44,44 59,44Q44,44 44,59Q44,44 29,44Q44,44 44,29z" />
    </group>
</vector>
